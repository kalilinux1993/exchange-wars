{
  "name": "exchange-wars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Market/trading tycoon game with a fully deterministic, headless economy engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p packages/ui",
    "sim": "tsx packages/cli/src/run.ts",
    "balance": "tsx packages/cli/src/balance.ts",
    "dev": "npm run dev -w @exchange-wars/ui",
    "build:ui": "npm run build -w @exchange-wars/ui",
    "e2e": "playwright test -c packages/ui"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
